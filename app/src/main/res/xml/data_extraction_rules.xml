<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules (API 31+). The encrypted session store is sealed with a
   Keystore key that is not restored alongside it, so backing it up would only
   produce an undecryptable file on the target device. Exclude it from both paths;
   the user signs in again after a restore or transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="questly_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="questly_session.xml" />
    </device-transfer>
</data-extraction-rules>
