<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules (API < 31). The encrypted session store is sealed with a
   Keystore key that does NOT travel with the backup, so restoring it would leave
   an undecryptable file. Exclude it; the user simply signs in again after a restore.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="questly_session.xml" />
</full-backup-content>
